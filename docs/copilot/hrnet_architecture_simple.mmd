flowchart LR
    A["Input"]:::input --> B["Preprocess"]:::pre --> C["HRNet-W32 Backbone"]:::backbone
    C --> D["Shared high-resolution feature<br/>48 channels"]:::feature

    D --> P1["Pose heatmap head<br/>13 heatmaps"]:::pose
    P1 --> P2["Dark decode → keypoints"]:::pose

    D --> G1["Wing branch<br/>1 Conv blocks<br/> + 1 FC<br/>3 logits"]:::wing
    D --> S1["Tail branch<br/>2 Conv block<br/> + 1 FC<br/>6 logits"]:::tail


    G1 --> O2["pred_classifiers['wing']"]:::out2
    S1 --> O3["pred_classifiers['tail']"]:::out2

    classDef input fill:#E8F1FF,stroke:#3B82F6,stroke-width:2px;
    classDef pre fill:#EEF2FF,stroke:#6366F1,stroke-width:2px;
    classDef backbone fill:#ECFDF5,stroke:#10B981,stroke-width:2px;
    classDef feature fill:#D1FAE5,stroke:#059669,stroke-width:2px;
    classDef pose fill:#FEF3C7,stroke:#F59E0B,stroke-width:2px;
    classDef wing fill:#FCE7F3,stroke:#DB2777,stroke-width:2px;
    classDef tail fill:#EDE9FE,stroke:#7C3AED,stroke-width:2px;
    classDef out1 fill:#FFF7ED,stroke:#EA580C,stroke-width:2px;
    classDef out2 fill:#F5F3FF,stroke:#8B5CF6,stroke-width:2px;

